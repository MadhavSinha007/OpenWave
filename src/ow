#!/bin/bash

COMMAND=$1
INPUT="${@:2}"

BASE_DIR="$HOME/OpenWave"

DOWNLOAD_DIR="$BASE_DIR/downloads"
LOG_DIR="$BASE_DIR/logs"

mkdir -p "$DOWNLOAD_DIR"
mkdir -p "$LOG_DIR"

banner() {

    echo ""
    echo "=================================="
    echo "           OpenWave"
    echo "=================================="
    echo ""
}

download_song() {

    TARGET="$1"

    yt-dlp \
        --extract-audio \
        --audio-format mp3 \
        --audio-quality 0 \
        --embed-thumbnail \
        --convert-thumbnails jpg \
        --add-metadata \
        --no-keep-video \
        --restrict-filenames \
        --newline \
        -o "$DOWNLOAD_DIR/%(title)s.%(ext)s" \
        "$TARGET"

    find "$DOWNLOAD_DIR" -type f \( \
        -name "*.webm" -o \
        -name "*.jpg" -o \
        -name "*.webp" -o \
        -name "*.m4a" \
    \) -delete
}

banner

case "$COMMAND" in

    download)

        URL="${@:2}"

        if [ -z "$URL" ]; then
            echo "Usage:"
            echo "./src/ow download <youtube-url>"
            echo ""
            exit 1
        fi

        echo "Downloading from URL..."
        echo ""

        download_song "$URL"
        ;;

    search)

        QUERY="${@:2}"

        if [ -z "$QUERY" ]; then
            echo "Usage:"
            echo './src/ow search "song name"'
            echo ""
            exit 1
        fi

        echo "Searching YouTube..."
        echo ""

        download_song "ytsearch1:$QUERY"
        ;;

    library)

        SUBCOMMAND=$2
        QUERY="${@:3}"

        DB="database/openwave.db"

        case "$SUBCOMMAND" in

            scan)

                echo ""
                echo "Scanning library..."
                echo ""

                python3 scripts/scan_library.py

                echo ""
                echo "Scan complete."
                echo ""
                ;;

            list)

                echo ""
                echo "Music Library"
                echo "-------------"

                sqlite3 -column -header "$DB" \
                "SELECT
                    id,
                    title,
                    artist,
                    ROUND(duration, 2) as duration
                 FROM tracks
                 ORDER BY title ASC;"

                echo ""
                ;;

            search)

                if [ -z "$QUERY" ]; then
                    echo ""
                    echo 'Usage: ./src/ow library search "query"'
                    echo ""
                    exit 1
                fi

                echo ""
                echo "Search Results"
                echo "--------------"

                sqlite3 -column -header "$DB" \
                "SELECT
                    id,
                    title,
                    artist,
                    album
                 FROM tracks
                 WHERE
                    title LIKE '%$QUERY%'
                 OR artist LIKE '%$QUERY%'
                 OR album LIKE '%$QUERY%'
                 ORDER BY title ASC;"

                echo ""
                ;;

            count)

                echo ""
                echo "Total Songs"
                echo "-----------"

                sqlite3 "$DB" \
                "SELECT COUNT(*) FROM tracks;"

                echo ""
                ;;

            clear)

                echo ""
                echo "Clearing library database..."
                echo ""

                sqlite3 "$DB" \
                "DELETE FROM tracks;"

                echo "Library cleared."
                echo ""
                ;;

            *)

                echo ""
                echo "Library Commands"
                echo "----------------"
                echo ""

                echo "./src/ow library scan"
                echo "./src/ow library list"
                echo './src/ow library search "query"'
                echo "./src/ow library count"
                echo "./src/ow library clear"

                echo ""
                ;;
        esac
        ;;

    *)

        echo "Commands"
        echo "--------"
        echo ""

        echo "./src/ow download <url>"
        echo './src/ow search "song name"'
        echo "./src/ow library"

        echo ""
        ;;
esac

echo ""
echo "Saved in:"
echo "$DOWNLOAD_DIR"
echo ""
