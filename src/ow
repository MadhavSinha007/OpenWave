#!/bin/bash

COMMAND=$1
INPUT="${@:2}"

BASE_DIR="$HOME/OpenWave"

DOWNLOAD_DIR="$BASE_DIR/downloads"
LOG_DIR="$BASE_DIR/logs"

mkdir -p "$DOWNLOAD_DIR"
mkdir -p "$LOG_DIR"
mkdir -p player

banner() {

    echo ""
    echo "=================================="
    echo "           OpenWave"
    echo "=================================="
    echo ""
}

download_song() {

    TARGET="$1"

    yt-dlp \
        --extract-audio \
        --audio-format mp3 \
        --audio-quality 0 \
        --embed-thumbnail \
        --convert-thumbnails jpg \
        --add-metadata \
        --no-keep-video \
        --restrict-filenames \
        --newline \
        -o "$DOWNLOAD_DIR/%(title)s.%(ext)s" \
        "$TARGET"

    find "$DOWNLOAD_DIR" -type f \( \
        -name "*.webm" -o \
        -name "*.jpg" -o \
        -name "*.webp" -o \
        -name "*.m4a" \
    \) -delete
}

play_song() {

    SONG=$(sqlite3 database/openwave.db \
    "SELECT filepath FROM tracks ORDER BY id DESC LIMIT 1;")

    if [ -z "$SONG" ]; then

        echo ""
        echo "No songs found in library."
        echo ""

        exit 1
    fi

    echo "$SONG" > player/current_track.txt

    echo ""
    echo "Now Playing:"
    echo "$SONG"
    echo ""

    mpv --no-video "$SONG"
}

pause_song() {

    pkill -STOP mpv

    echo ""
    echo "Playback paused."
    echo ""
}

resume_song() {

    pkill -CONT mpv

    echo ""
    echo "Playback resumed."
    echo ""
}

stop_song() {

    pkill mpv

    echo ""
    echo "Playback stopped."
    echo ""
}

now_playing() {

    if [ -f player/current_track.txt ]; then

        echo ""
        echo "Currently Playing:"
        cat player/current_track.txt
        echo ""

    else

        echo ""
        echo "Nothing playing."
        echo ""
    fi
}

add_to_queue() {

    QUERY="$*"

    SONG=$(sqlite3 database/openwave.db \
    "SELECT filepath FROM tracks
     WHERE title LIKE '%$QUERY%'
     LIMIT 1;")

    if [ -z "$SONG" ]; then

        echo ""
        echo "Song not found."
        echo ""

        exit 1
    fi

    echo "$SONG" >> player/queue.txt

    echo ""
    echo "Added to queue:"
    echo "$SONG"
    echo ""
}

show_queue() {

    echo ""
    echo "Current Queue"
    echo "-------------"

    if [ ! -s player/queue.txt ]; then

        echo "Queue is empty."
        echo ""

        return
    fi

    nl -w2 -s'. ' player/queue.txt

    echo ""
}

clear_queue() {

    > player/queue.txt

    echo ""
    echo "Queue cleared."
    echo ""
}

play_queue() {

    if [ ! -s player/queue.txt ]; then

        echo ""
        echo "Queue is empty."
        echo ""

        exit 1
    fi

    while IFS= read -r SONG; do

        echo "$SONG" > player/current_track.txt

        echo "$SONG" >> player/history.txt

        echo ""
        echo "Now Playing:"
        echo "$SONG"
        echo ""

        mpv --no-video "$SONG"

    done < player/queue.txt

    > player/queue.txt
}

next_song() {

    pkill mpv

    echo ""
    echo "Skipping track..."
    echo ""
}

previous_song() {

    SONG=$(tail -n 2 player/history.txt | head -n 1)

    if [ -z "$SONG" ]; then

        echo ""
        echo "No previous track."
        echo ""

        exit 1
    fi

    echo "$SONG" > player/current_track.txt

    echo ""
    echo "Playing Previous Track:"
    echo "$SONG"
    echo ""

    mpv --no-video "$SONG"
}

create_playlist() {

    NAME="$1"

    if [ -z "$NAME" ]; then

        echo ""
        echo "Playlist name required."
        echo ""

        exit 1
    fi

    sqlite3 database/openwave.db \
    "INSERT INTO playlists (name)
     VALUES ('$NAME');"

    echo ""
    echo "Playlist created:"
    echo "$NAME"
    echo ""
}

list_playlists() {

    echo ""
    echo "Playlists"
    echo "---------"

    sqlite3 -column -header database/openwave.db \
    "SELECT id, name FROM playlists;"

    echo ""
}

delete_playlist() {

    NAME="$1"

    sqlite3 database/openwave.db \
    "DELETE FROM playlists
     WHERE name='$NAME';"

    echo ""
    echo "Playlist deleted:"
    echo "$NAME"
    echo ""
}

add_song_to_playlist() {

    PLAYLIST="$1"

    shift

    QUERY="$*"

    PLAYLIST_ID=$(sqlite3 database/openwave.db \
    "SELECT id FROM playlists
     WHERE name='$PLAYLIST';")

    if [ -z "$PLAYLIST_ID" ]; then

        echo ""
        echo "Playlist not found."
        echo ""

        exit 1
    fi

    TRACK_ID=$(sqlite3 database/openwave.db \
    "SELECT id FROM tracks
     WHERE title LIKE '%$QUERY%'
     LIMIT 1;")

    if [ -z "$TRACK_ID" ]; then

        echo ""
        echo "Song not found."
        echo ""

        exit 1
    fi

    sqlite3 database/openwave.db \
    "INSERT INTO playlist_tracks
     (playlist_id, track_id)
     VALUES ($PLAYLIST_ID, $TRACK_ID);"

    echo ""
    echo "Song added to playlist."
    echo ""
}

show_playlist() {

    NAME="$1"

    echo ""
    echo "Playlist: $NAME"
    echo "----------------"

    sqlite3 -column -header database/openwave.db \
    "
    SELECT tracks.id,
           tracks.title,
           tracks.artist
    FROM tracks
    JOIN playlist_tracks
      ON tracks.id = playlist_tracks.track_id
    JOIN playlists
      ON playlists.id = playlist_tracks.playlist_id
    WHERE playlists.name = '$NAME';
    "

    echo ""
}

play_playlist() {

    NAME="$1"

    SONGS=$(sqlite3 database/openwave.db \
    "
    SELECT tracks.filepath
    FROM tracks
    JOIN playlist_tracks
      ON tracks.id = playlist_tracks.track_id
    JOIN playlists
      ON playlists.id = playlist_tracks.playlist_id
    WHERE playlists.name = '$NAME';
    ")

    if [ -z "$SONGS" ]; then

        echo ""
        echo "Playlist is empty or missing."
        echo ""

        exit 1
    fi

    echo "$SONGS" > player/queue.txt

    play_queue
}

banner

case "$COMMAND" in

    download)

        URL="${@:2}"

        if [ -z "$URL" ]; then

            echo "Usage:"
            echo "./src/ow download <youtube-url>"
            echo ""

            exit 1
        fi

        echo "Downloading from URL..."
        echo ""

        download_song "$URL"
        ;;

    search)

        QUERY="${@:2}"

        if [ -z "$QUERY" ]; then

            echo "Usage:"
            echo './src/ow search "song name"'
            echo ""

            exit 1
        fi

        echo "Searching YouTube..."
        echo ""

        download_song "ytsearch1:$QUERY"
        ;;

    play)

        play_song
        ;;

    pause)

        pause_song
        ;;

    resume)

        resume_song
        ;;

    stop)

        stop_song
        ;;

    nowplaying)

        now_playing
        ;;

    queue)

        SUBCOMMAND=$2

        case "$SUBCOMMAND" in

            add)

                add_to_queue "${@:3}"
                ;;

            show)

                show_queue
                ;;

            clear)

                clear_queue
                ;;

            play)

                play_queue
                ;;

            *)

                echo ""
                echo "Queue Commands"
                echo "--------------"
                echo ""

                echo './src/ow queue add "song"'
                echo "./src/ow queue show"
                echo "./src/ow queue play"
                echo "./src/ow queue clear"

                echo ""
                ;;
        esac
        ;;

    next)

        next_song
        ;;

    previous)

        previous_song
        ;;

    playlist)

        SUBCOMMAND=$2

        case "$SUBCOMMAND" in

            create)

                create_playlist "$3"
                ;;

            list)

                list_playlists
                ;;

            delete)

                delete_playlist "$3"
                ;;

            add)

                PLAYLIST_NAME="$3"

                add_song_to_playlist \
                "$PLAYLIST_NAME" "${@:4}"
                ;;

            show)

                show_playlist "$3"
                ;;

            play)

                play_playlist "$3"
                ;;

            *)

                echo ""
                echo "Playlist Commands"
                echo "-----------------"
                echo ""

                echo "./src/ow playlist create <name>"
                echo "./src/ow playlist list"
                echo "./src/ow playlist delete <name>"

                echo ""

                echo './src/ow playlist add chill "interstellar"'

                echo "./src/ow playlist show <name>"
                echo "./src/ow playlist play <name>"

                echo ""
                ;;
        esac
        ;;

    library)

        SUBCOMMAND=$2
        QUERY="${@:3}"

        DB="database/openwave.db"

        case "$SUBCOMMAND" in

            scan)

                echo ""
                echo "Scanning library..."
                echo ""

                python3 scripts/scan_library.py

                echo ""
                echo "Scan complete."
                echo ""
                ;;

            normalize)

                echo ""
                echo "Normalizing metadata..."
                echo ""

                python3 scripts/normalize_metadata.py

                echo ""
                echo "Normalization complete."
                echo ""
                ;;

            list)

                echo ""
                echo "Music Library"
                echo "-------------"

                sqlite3 -column -header "$DB" \
                "SELECT
                    id,
                    title,
                    artist,
                    ROUND(duration, 2) as duration
                 FROM tracks
                 ORDER BY title ASC;"

                echo ""
                ;;

            search)

                if [ -z "$QUERY" ]; then

                    echo ""
                    echo 'Usage: ./src/ow library search "query"'
                    echo ""

                    exit 1
                fi

                echo ""
                echo "Search Results"
                echo "--------------"

                sqlite3 -column -header "$DB" \
                "SELECT
                    id,
                    title,
                    artist,
                    album
                 FROM tracks
                 WHERE
                    title LIKE '%$QUERY%'
                 OR artist LIKE '%$QUERY%'
                 OR album LIKE '%$QUERY%'
                 ORDER BY title ASC;"

                echo ""
                ;;

            count)

                echo ""
                echo "Total Songs"
                echo "-----------"

                sqlite3 "$DB" \
                "SELECT COUNT(*) FROM tracks;"

                echo ""
                ;;

            clear)

                echo ""
                echo "Clearing library database..."
                echo ""

                sqlite3 "$DB" \
                "DELETE FROM tracks;"

                echo "Library cleared."
                echo ""
                ;;

            *)

                echo ""
                echo "Library Commands"
                echo "----------------"
                echo ""

                echo "./src/ow library scan"
                echo "./src/ow library normalize"
                echo "./src/ow library list"
                echo './src/ow library search "query"'
                echo "./src/ow library count"
                echo "./src/ow library clear"

                echo ""
                ;;
        esac
        ;;

    *)

        echo "Commands"
        echo "--------"
        echo ""

        echo "./src/ow download <url>"
        echo './src/ow search "song name"'

        echo ""

        echo "./src/ow play"
        echo "./src/ow pause"
        echo "./src/ow resume"
        echo "./src/ow stop"
        echo "./src/ow nowplaying"

        echo ""

        echo './src/ow queue add "song"'
        echo "./src/ow queue show"
        echo "./src/ow queue play"
        echo "./src/ow queue clear"

        echo ""

        echo "./src/ow next"
        echo "./src/ow previous"

        echo ""

        echo "./src/ow playlist"

        echo ""

        echo "./src/ow library"

        echo ""
        ;;
esac

echo ""
echo "Saved in:"
echo "$DOWNLOAD_DIR"
echo ""
